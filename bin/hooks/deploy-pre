#!/bin/bash
# Before `ts deploy` sends anything: the route tests, and one more.
#
# Not the whole suite: five tests elsewhere (argument removal and the
# improvement agent's triggers) fail on master as of 2026-10-24, and a gate
# that can never pass is a gate everybody learns to skip. These say whether the
# API answers as its clients expect, plus the one that says the agent workers
# wait rather than spin (they held a core of the box at idle until 2026-10-26).
set -euo pipefail
cd "$TS_ROOT"
echo "→ tests"
python3 -m pytest -q -p no:logging src/tests/test_api_*.py src/tests/test_agent_workers.py >/dev/null
